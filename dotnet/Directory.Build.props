<Project>
  <!-- Shared settings and NuGet metadata for every NanoFlags .NET project. Nothing here publishes anything. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 0.1.0, unreleased (see CHANGELOG.md). -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>NanoFlags</Authors>
    <Company>NanoFlags</Company>
    <Copyright>Copyright 2026 Alibtekarat Althkiya Company for Trading &amp; Marketing (Intinovate)</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://nanoflags.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/motazalmaroai/nanoflags-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>feature-flags;feature-toggles;nanoflags;openfeature;rollouts</PackageTags>
    <PackageReleaseNotes>https://github.com/motazalmaroai/nanoflags-sdk/blob/main/dotnet/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
