{
  "name": "@nanoflags/mcp",
  "version": "0.1.0",
  "description": "NanoFlags MCP server: lets coding agents create flags, edit drafts and open change requests through the Management API. Agents propose; people approve and publish.",
  "keywords": [
    "nanoflags",
    "feature-flags",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "homepage": "https://nanoflags.io/docs/ai-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motazalmaroai/nanoflags-sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/motazalmaroai/nanoflags-sdk/issues"
  },
  "type": "module",
  "bin": {
    "nanoflags-mcp": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "author": "Alibtekarat Althkiya Company for Trading & Marketing (Intinovate) <support@nanoflags.io>"
