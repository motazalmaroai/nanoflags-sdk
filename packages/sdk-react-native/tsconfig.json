{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@nanoflags/engine": ["../engine/src/index.ts"],
      "@nanoflags/sdk": ["../sdk/src/index.ts"],
      "@nanoflags/sdk/react": ["../sdk/src/react.ts"],
      "@nanoflags/openfeature-provider": ["../openfeature/src/index.ts"],
      "@nanoflags/openfeature-provider/web": ["../openfeature/src/web.ts"]
    }
  },
  "include": ["src", "test"]
}
